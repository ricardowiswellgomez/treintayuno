{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "treseiscinco",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_USER_LIMITER",
      "namespace_id": "310261026",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
