{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "treintayuno",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  }
}
